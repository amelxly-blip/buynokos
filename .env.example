# ==========================================
# BUYNOKOS ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Supabase (Database, Auth, and Realtime)
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SMS OTP Provider (SMS-Activate, 5sim, atau Provider Lokal)
# Dapatkan API Key di: https://sms-activate.org/en/api2
SMS_PROVIDER_TYPE=sms-activate
SMS_ACTIVATE_API_KEY=your_sms_activate_api_key_here

# 3. QRIS Payment Gateway (Pilih: tokopay / pakasir / tripay / sandbox)
# Untuk test coba dulu pakai: sandbox (bisa simulasi bayar otomatis)
PAYMENT_GATEWAY_PROVIDER=sandbox
# Tokopay credentials:
TOKOPAY_MERCHANT_ID=
TOKOPAY_SECRET_KEY=
# Pakasir credentials:
PAKASIR_API_KEY=
# Tripay credentials:
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# 4. Markup Engine (Pengaturan Keuntungan Penjual)
GLOBAL_MARKUP_PERCENT=35
MIN_PRICE_IDR=1500
ADMIN_SECRET_KEY=admin_secret_super_secure_key_123

# 5. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
